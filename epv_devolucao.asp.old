	</script>
    
       <script type="text/javascript">		 
	   /*
		function beep(){
			document.getElementById('beepFrame').contentWindow.alertBeep();
		}
*/
		
		function runScript(e,campo) {
			
			mascara(campo,soNumeros);
			
			if (e.keyCode == 13) {
				gravarItem();
				return false;
			}
		}
		
		
		
		function displayLeitura(tipo,msg){
			$('#sucesso_msg').hide();
			$('#erro_msg').hide();
			
			if(tipo == 'erro'){
				$('#erro_msg').show();
				$('#erro_msg').html(msg)	
			}else{
				$('#sucesso_msg').show();
				$('#sucesso_msg').html(msg);
				//beep();
			}
			$("#TXT_DEVOLUCAO").val('');		
		}
		
        </script>

		<script type="text/javascript" language="javascript">
