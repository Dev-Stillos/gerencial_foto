			$("#TXT_DEVOLUCAO").focus();
		}
		function gravarItem(){
			var etiqueta = $("#TXT_DEVOLUCAO").val();
			if(etiqueta !== ''){
				var caminho = 'epv_movimentacoes_estoque_ajax.asp?ts=incluir&p1='+etiqueta;
				ajax_loadContent('retorna_div',caminho,false,false,true);
				
				/*
				displayCarregando();
				
				var html = $.ajax({
		  			url: caminho,
		  			async: false
				}).responseText;
				
				var arrayPrincipal;
				
				if(html.indexOf('erro#') == 0){
					arrayPrincipal = html.split('#')
					//Executa tarefas, verifica se está habilitado	
					if(arrayPrincipal[1] !== ""){
							eval(arrayPrincipal[1]);
					}
				}else{
					arrayPrincipal = html.split('#')
					//Parametros de sucesso
					if(arrayPrincipal[1] == "true" ){
						eval(arrayPrincipal[2]);
					}
				}			
						
				$("#retorna_div").html(html);
				
				displayCarregandoClose();
