function get_content($URL) {
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
    curl_setopt($ch, CURLOPT_URL, $URL);
    $data = curl_exec($ch);
    curl_close($ch);
    return $data;
}

function preencheCaracter($str, $caracter_complemento, $qtd) {
	$retorno = $str;

	while (strlen($retorno) < $qtd) {
		$retorno = $caracter_complemento . $retorno;
	}

	return $retorno;
}

function buscaSacado($cod_pedido, $cods_boleto) {
	if ($cod_pedido != '') 
		$sql = "SELECT cod_sacado FROM TB_PEDIDOS_BOLETOS WHERE cod_pedido = " . $cod_pedido;
	else
		$sql = "SELECT cod_sacado FROM TB_PEDIDOS_BOLETOS WHERE cod_boleto in ( " . $cods_boleto . ")";
	
	$conn = new Conexao();
	$conn->openDataBase();

	$query = mysql_query($sql);
	if ($rs = mysql_fetch_array($query)) 
		$r = $rs['cod_sacado'];

	$conn->closeDataBase();

	return $r;
}

function buscaParametro($nome) {
	
	$conn = new Conexao();
	$conn->openDataBase();

	$query = mysql_query("SELECT valor FROM TB_PARAMETROS WHERE nome = '$nome'");
	if ($rs = mysql_fetch_array($query)) 
		$r = $rs['valor'];
	
	$conn->closeDataBase();

	return $r;
}


if(buscaParametro('enviar_email') == 'N') {
	die('Agendamento de boletos dasabilitado');
}



$r = array('cod_pedido' => '', 'status' => '', 'msg' => '', 'tempo_execucao' => '', 'info' => '');
$arquivos = array();
$cod_sacado = '';
$time = microtime(1);



try {
	//verificar forma de segurança
	$con = new Conexao();
	$con->openDataBase();

	//Buscamos um pedido via boleto que ainda não foi enviado
	$sql = "SELECT * FROM TB_PEDIDOS WHERE finaliza_vendedor = 1 AND cod_sacado is not null AND boleto_enviado = 'N' limit 1 ";
	$query = mysql_query($sql);
	if ($rs = mysql_fetch_array($query)) {
		$cod = $rs['COD_PEDIDO'];
		$cod_sacado = $rs['cod_sacado'];		
	}

	$r['cod_pedido'] = $cod;
	$sql = "SELECT * FROM TB_PEDIDOS_BOLETOS WHERE cod_pedido = ".$cod;

	if ($cod) {
		$query = mysql_query($sql);
		while ($rs = mysql_fetch_array($query) ) {

			$resultado = get_content("http://". $_SERVER["HTTP_HOST"] ."/gerencial_foto/xdwfsfdgn.asp?h=".$rs['hash']);

			$mpdf = new mPDF();
			$mpdf->WriteHTML(utf8_encode($resultado));
			$nome_arquivo = "boleto_".$rs["cod_pedido"]."_".preencheCaracter($rs["parcela"],"0",2).".pdf";
			$mpdf->Output($con->getPathDados()."boletos\\".$nome_arquivo, 'F');		
			unset($mpdf);

			$arquivos[] = $nome_arquivo;
		}
	
		$con->closeDataBase();
		$con->openDataBase();

		$sql = "SELECT * FROM TB_SACADOS WHERE cod_sacado = ".$cod_sacado;
		$query = mysql_query($sql);
		if ($rs = mysql_fetch_array($query) ) 
		{
		 $sacado = $rs;

			$from_nome = "Stillo's Reportagens Fotográficas";
			$subject = "Boletos";
			$from  = "noreply@stillos.com.br";
			$host = "smtplw.com.br";
			$username = "stillosadm2";
			$password  = "xwpdkwem4525";
			$mensagem_email = "Prezado(a) [NOME], <br />
								<br />
								Segue anexo os boletos referentes a sua compra. <br>
								Se já recebeu anteriormente por favor desconsidere este e-mail.
								<br /><br />
								******************************************<br />
								ENVIO AUTOMÁTICO, NÃO RESPONDA ESTE E-MAIL<br />
								******************************************<br />";

			$mensagem_email = str_replace("[NOME]", $rs['nome'], $mensagem_email);

			$mail = new PHPMailer();
			$mail->IsSMTP();
			$mail->SMTPAuth = true;
			$mail->Host = $host;
