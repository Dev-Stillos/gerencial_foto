			$mail->AddBCC("reports@stillos.com.br");
			
			foreach ($arquivos as $arquivo) {
				$mail->AddAttachment($con->getPathDados()."boletos\\".$arquivo);
			}
			$mail->Send();
		}

		//marcamos como enviado o pedido
		mysql_query("UPDATE TB_PEDIDOS SET boleto_enviado = 'S' WHERE cod_pedido = ".$cod);

		$r['status'] = '0';
		$r['msg'] = 'boletos enviados com sucesso!';
		$r['info'] = $sacado ;
	}
	else
	{
		$r['status'] = '1';
		$r['msg'] = 'Nenhum codigo encontrado';
	}

	$con->closeDataBase();

} 
catch (Exception $e) {
    $r['status'] = $e->getCode();
	$r['msg'] =  $e->getMessage();
}

$r['tempo_execucao'] =  ((microtime(1) - $time));
ob_clean();
echo json_encode($r);

