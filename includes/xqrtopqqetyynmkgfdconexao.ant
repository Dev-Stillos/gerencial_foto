			objCDOSYSMail.BCC  = copiaOculta
		End If
				
		objCDOSYSMail.ReplyTo = sResponder 
		objCDOSYSMail.Subject = sAssunto 
		objCDOSYSMail.HtmlBody = mensagem
		
		
		If Len(para) > 3 or Len(copia) > 3 or Len(copiaOculta) Then
		'Pelo menos 1 destes deve estar preenchido para enviar o e-mail
			objCDOSYSMail.Send 
		End If
		
		Set objCDOSYSMail = Nothing 
		Set objCDOSYSCon = Nothing

End Sub


'Verifica se o pedido possui os produtos com valor correto, se hover retorna true
Function pedidoProdutoValorCorreto(cod_pedido,conexao_aberta)

	Dim rs, rs2, sql, produtosValoresCorretos
	Dim valor_vendido, valor_padrao, diferenca, qtd_parcelas, cod_foto_padrao, grupo_vendedores, cod_vendedor
	produtosValoresCorretos = True
	
	If not conexao_aberta Then
		AbrirConexao()
	End if
	
	Set rs=objConexao.Execute("SELECT qtd_parcelas, cod_vendedor FROM TB_PEDIDOS where cod_pedido = "&sqlTexto(cod_pedido))
		
		If not rs.Eof Then
			qtd_parcelas = formatNumber(0&rs("qtd_parcelas"),0)	
			cod_vendedor = rs("cod_vendedor")
		End If

	rs.Close
	Set rs=Nothing
	

	Set rs=objConexao.Execute("SELECT COD_GRUPO_VENDEDORES FROM TB_VENDEDORES where COD_VENDEDOR = "&sqlTexto(cod_vendedor))
		
		If not rs.Eof Then
			grupo_vendedores = formatNumber(0&rs("COD_GRUPO_VENDEDORES"),0)	
		End If

	rs.Close
	Set rs=Nothing

	If qtd_parcelas > 0 Then
	'Verifica, por que È maior que 0
		
		'///////////////////////////////////////////////////////////////////////
		'1) Seleciona todos os formandos do pedido e seus respectivos contratos
			sql =	" SELECT TB_FICHAS_IDENTIFICACAO.COD_CONTRATO, TB_FICHAS_IDENTIFICACAO.COD_PRODUCAO,"&_
					" TB_FICHAS_IDENTIFICACAO.FATURADO, TB_FICHAS_IDENTIFICACAO.VALOR_UN, TB_PEDIDOS_FORMANDOS.COD_FORMANDO "&_
					" FROM TB_FICHAS_IDENTIFICACAO INNER JOIN TB_PEDIDOS_FORMANDOS ON "&_
					" TB_FICHAS_IDENTIFICACAO.COD_FORMANDO = TB_PEDIDOS_FORMANDOS.COD_FORMANDO "&_
					" WHERE TB_PEDIDOS_FORMANDOS.COD_PEDIDO = "&sqlTexto(cod_pedido)
		
			Set rs=objConexao.Execute(sql)
		
				While not rs.Eof
				
				'InÌcia v·riaveis
				valor_vendido	= 0
				valor_padrao	= 0
				diferenca		= 0
				'//////////////////
				
						'1.1) Verifica o ·lbum do formando, para isso È necess·rio saber a foto padr„o de acordo com a produÁ„o.
								'1.1.1) Verifica foto padr„o de acordo com produÁ„o
								Set rs2 = objConexao.Execute("SELECT COD_FOTO_PADRAO FROM TB_PRODUCAO WHERE COD_PRODUCAO="&rs("COD_PRODUCAO"))
									If not rs2.Eof Then				
										cod_foto_padrao = rs2("cod_foto_padrao")
									Else
										cod_foto_padrao = 2
									End If
								rs2.Close()
								Set rs2 = Nothing
								
						
						
						valor_padrao = valorProdutoGeral(cod_foto_padrao,rs("COD_CONTRATO"),qtd_parcelas,true,grupo_vendedores)
						valor_vendido = formatNumber(0&rs("VALOR_UN"))
						
						If valor_padrao > 0 and valor_vendido > 0 Then
	  		
							diferenca = (valor_vendido-valor_padrao)/1
							diferenca = formatNumber(diferenca)
			
							If diferenca < 0 Then
								'Valor fora do padr„o
								produtosValoresCorretos = false
							End If	
						
						End If		
								
						'1.2) Verifica nos produtos agregados deste formando.
						sql =	" SELECT TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.COD_PRODUTO, TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.COD_PRODUTO_AGREGADO, TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.TIPO, "&_
								" Sum(TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.QUANTIDADE) as QUANTIDADE, "&_
								" TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.VENDIDO, TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.VALOR_UN, "&_
								" TB_PRODUTOS.NOME_PRODUTO FROM TB_PRODUTOS INNER JOIN TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS "&_
								" ON TB_PRODUTOS.COD_PRODUTO = TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.COD_PRODUTO "&_
								" WHERE TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.COD_FORMANDO="&rs("COD_FORMANDO")&_
								" GROUP BY TB_FICHAS_IDENTIFICACAO_PRODUTOS_AGREGADOS.COD_PRODUTO "
						
						Set rs2=objConexao.Execute(sql)
							
								'Pode ser mais que um produto agregado
								While not rs2.Eof
										
									valor_padrao = valorProdutoGeral(rs2("COD_PRODUTO"),rs("COD_CONTRATO"),qtd_parcelas,true,grupo_vendedores)
									valor_vendido = formatNumber(0&rs2("VALOR_UN"))
									
									If valor_padrao > 0 and valor_vendido > 0 Then
						
										diferenca = (valor_vendido-valor_padrao)/1
										diferenca = formatNumber(diferenca)
						
										If diferenca < 0 Then
											'Valor fora do padr„o
											produtosValoresCorretos = false
										End If	
									
									End If		
											
								rs2.MoveNext()
								Wend
								
						rs2.Close
						Set rs2=Nothing
						
						'1.3) Verifica nos produtos vendidos ‡ parte deste formando.
						sql = 	" SELECT TB_PEDIDOS_PRODUTOS.COD_PRODUTO, TB_PEDIDOS_PRODUTOS.VALOR_UN "&_
								" FROM TB_PEDIDOS_PRODUTOS "&_	
								" WHERE COD_PEDIDO="&cod_pedido&" AND COD_FORMANDO="&rs("COD_FORMANDO")
						
						Set rs2=objConexao.Execute(sql)
							
							If not rs2.Eof Then
								
								While not rs2.Eof
									
									valor_padrao = valorProdutoGeral(rs2("COD_PRODUTO"),rs("COD_CONTRATO"),qtd_parcelas,true,grupo_vendedores)
									valor_vendido = formatNumber(0&rs2("VALOR_UN"))
									
									If valor_padrao > 0 and valor_vendido > 0 Then
						
										diferenca = (valor_vendido-valor_padrao)/1
										diferenca = formatNumber(diferenca)
						
										If diferenca < 0 Then
											'Valor fora do padr„o
											produtosValoresCorretos = false
										End If	
									
									End If		
									
									
								rs2.MoveNext()
								Wend
							
							End If
						
						rs2.Close
						Set rs2=Nothing
						
				rs.MoveNext()
				Wend
				
			
			rs.Close
			Set rs=Nothing		
		'///////////////////////////////////////////////////////////////////////	
	Else
		'Pedido n„o pode ser an·lisado, por tanto retornar true
		produtosValoresCorretos = true
		
	End If
		
	If not conexao_aberta Then
		FecharConexao()
	End if

	pedidoProdutoValorCorreto = produtosValoresCorretos

End Function

'Verifica o valor do produto de acordo com o cÛd do produto e o cÛd do contrato, esta deve ser utilizada para consultar de preÁos
Function valorProdutoGeral(cod_produto,cod_contrato,qtd_parcelas,conexao_aberta,grupo_vendedores)
	
	Dim rs, rs2, sql
	Dim verificaTabelaPadrao, cod_valor, valor
	
	verificaTabelaPadrao = true
	
	If grupo_vendedores > 0 Then
		grupo_vendedores = 1
	End If
	
	
	'1) Verifica se h· boletim informativo, se houver busca o valor do produto de acordo com o boletim informativo, caso contr·rio busca na tabela de produtos padr„o, se n„o encontrar retorna o valor 0 indicando que o produto n„o possui preÁo em nenhum lugar erro
	
	If not conexao_aberta Then
		AbrirConexao()
	End if
		
		'1) Verifica se h· boletim informativo para o contrato informado
		Set rs=objConexao.Execute("SELECT * FROM TB_BOLETIM_INFORMATIVO_CONTRATOS WHERE COD_CONTRATO = "&sqlTexto(cod_contrato))	
			
			If not rs.Eof Then
				'1.2) Existe, verifica se o produto desejado est· no boletim
				
				sql = "SELECT * FROM TB_BOLETIM_INFORMATIVO_PRODUTOS WHERE COD_PRODUTO = "&sqlTexto(cod_produto)&" AND cod_boletim_informativo = "&rs("cod_boletim_informativo")
								
				Set rs2=objConexao.Execute(sql)
					
					If not rs2.Eof Then
						
						'1.3) Existe por tanto n„o È necess·rio verifica na tabela padr„o
						verificaTabelaPadrao = false
						
						If int(qtd_parcelas) = 1 Then
						'¿ vista
							valor = formatNumber(rs2("VALOR_A_VISTA"))
						Elseif int(qtd_parcelas) = 2 or int(qtd_parcelas) = 3 Then
						'2X ou 3X
							valor = formatNumber(rs2("VALOR_3X"))
						Else
						'Acima de 3X
							valor = formatNumber(rs2("VALOR_PARCELADO"))
						End If 					
							
					End If
					
				rs2.Close
				Set rs2=Nothing
				
			End If
			
		rs.Close
		Set rs=Nothing	
	
	If not conexao_aberta Then
		FecharConexao()
	End if
	
	If verificaTabelaPadrao Then
		'2) Verifica o preÁo padr„o de acordo com o cÛdigo do produto
		cod_valor = valorProdutoVigente(cod_produto,conexao_aberta,grupo_vendedores)
		valor = valorProdutoCodProduto(cod_valor,qtd_parcelas,conexao_aberta)
	End If
	
	valorProdutoGeral = valor
	
End Function


Function valorProdutoCodProduto(cod_valor,qtd_parcelas,conexao_aberta)
	'Retorna o valor de acordo com o cÛd do valor, se for 0 quer dizer que n„o foi encontrado.
		
		Dim rs, valor
		valor = 0
		
		If not conexao_aberta Then
			AbrirConexao()
		End if
		
		Set rs=objConexao.Execute("SELECT * FROM TB_PRODUTOS_VALORES WHERE COD_VALOR = '"&cod_valor&"'")
		
			If not rs.Eof Then
				
				If int(qtd_parcelas) = 1 Then
				'¿ vista
					valor = formatNumber(rs("VALOR_A_VISTA"))
				Elseif int(qtd_parcelas) = 2 or int(qtd_parcelas) = 3 Then
				'2X ou 3X
					valor = formatNumber(rs("VALOR_3X"))
				Else
				'Acima de 3X
					valor = formatNumber(rs("VALOR_PARCELADO"))
				End If 
				
			End If
			
		rs.Close
		Set rs=Nothing
		
		If not conexao_aberta Then
			FecharConexao()
		End if	
	
		valorProdutoCodProduto = valor
	
End Function


'FunÁ„o que procura o cod_valor vigente do produto da tabela padr„o
Function valorProdutoVigente(cod_produto,conexao_aberta,grupo_vendedores)
	
	'grupo_vendedores = 0 significa vendedores comum, grupo_vendedores > 0 significa grupo repasse (normalmente 1 ou 2)
	If grupo_vendedores > 0 Then
		grupo_vendedores = 1
	End If
	
	Dim rs, cod_valor
	cod_valor = 0 'Por padr„o È 0, ou seja n„o encontrado nada!
		
		If not conexao_aberta Then
			AbrirConexao()
		End if
			
			Set rs=objConexao.Execute("SELECT TB_PRODUTOS_VALORES.*, DATEDIFF(VALIDO_ATE,NOW()) AS QTD_DIAS_PARA_VENCIMENTO  FROM TB_PRODUTOS_VALORES WHERE DATEDIFF(VALIDO_ATE,NOW()) >= 0 AND COD_PRODUTO = "&cod_produto&" AND grupo_vendedores = '"&grupo_vendedores&"' ORDER BY DATEDIFF(VALIDO_ATE,NOW()) ASC LIMIT 1")
					
					If not rs.Eof Then
						cod_valor = rs("cod_valor")
					End If
			
			rs.Close
			Set rs=Nothing
		
		If not conexao_aberta Then
			FecharConexao()
		End if
			
		valorProdutoVigente = cod_valor

End Function

Function validaUsuario(tipo,cod_pagina,cod_sub_validacao,conexao_aberta)
	'Verificamos se È o usuario admisnitrador se for garantimos acesso 
	if Session("cod_usuario") = 1 then
		validaUsuario = true
	else
		If not conexao_aberta Then
			AbrirConexao()	
		End If
		
		Dim rs, sql, retorna
		retorna = false
		
		If tipo = 1 Then
		'ValidaÁ„o de P·gina p·i
			sql = "Select COD_PERMISSAO From TB_ADM_PERFIS_PAGINAS_HABILITADAS where COD_PAGINA = '"&cod_pagina&"' and cod_perfil = '"&Session("cod_perfil")&"'"
		ElseIf tipo = 2 Then
		'SubvalidaÁ„o
			sql = "Select COD_PERMISSAO_SUB_VALIDACAO From TB_ADM_PERFIS_PAGINAS_HABILITADAS_SUB_VALIDACOES where COD_SUB_VALIDACAO = '"&cod_sub_validacao&"' and cod_perfil = '"&Session("cod_perfil")&"'"	
		End if

		Set rs=objConexao.Execute(sql)
			
		If not rs.Eof Then
			retorna = true
		End If
			
		rs.Close
		Set rs=Nothing
		
		If not conexao_aberta Then
			FecharConexao()
		End If
		
		validaUsuario = retorna
	end if

End Function

'Rotina que cria a p·ginaÁ„o nas p·ginas de listagem
	'Exemplo da utilizaÁ„o:
	'If rs.PageCount > 1 Then                               
	'     <tr bgcolor="whitesmoke">
	'      <td colspan="8">
	'      	   call paginacao(paginacaocao,rs.PageCount) 	                    
	'      </td>
	'    </tr>   
	'End if
Sub paginacao(pagina_atual,qtd_paginas)

	Dim query_string, inicio_posicao_paginacao, fim_posicao_paginacao
	Dim paginacao_menu
	Dim i, temp
	
	'1a parte corrige o query string
	'///////////////////////////////////////
	query_string = ""&Request.ServerVariables("QUERY_STRING")
	
	If query_string <> "" Then	
	'Tira a query de paginaÁ„o
		inicio_posicao_paginacao = InStr(query_string,"paginacao")	
		If int(inicio_posicao_paginacao) <> 0 Then
			'Retira a paginaÁ„o para colocar a correta
			temp = qtd_paginas
			For i=0 to qtd_paginas
								
				query_string = Replace(query_string,"paginacao="&temp,"")
				
				temp = (temp-1)/1
				
			Next
		End If
	
	End If
	
	'Quando a query for somente a p·ginaÁ„o tira o & da string
	
	
	
	If Cstr(query_string) = Cstr("&") Then
		query_string = ""
	Elseif Cstr(query_string) <> "" Then
		'Se n„o tiver somente este campo colocar o & no final	
		query_string = "&"&query_string
		
		'Corrige a duplicidade de &
		query_string = Replace(query_string,"&&","&")
	End If
	
	
	'2a parte coloca a p·ginaÁ„o se houver mais que uma p·gina
	
	If int(pagina_atual) > int(qtd_paginas) Then
	'Corrige se o usu·rio colocar uma p·gina superior a qtd de p·ginas
		pagina_atual = qtd_paginas
	End If

	If int(pagina_atual) = 0 Then
	'Corrige se o usu·rio colocar a p·gina 0
		pagina_atual = 1
	End If	
	
	
	If int(qtd_paginas) > 1 Then

	 	Response.Write("Ir para a p·gina:<br />")
	
		If int(qtd_paginas) < 1171 Then
		
			Response.Write("<div class='menu_paginacaocao'>")
	
				For x=1 To qtd_paginas				
					If int(pagina_atual) <> int(x) Then
						Response.Write(" <a href='?paginacao="&x&query_string&"'>"&x&"</a> ")					
					Else
						Response.Write("<span>"&x&"</span>")
					End If				
				Next
			
			Response.Write("</div>")
	
		Else
		
			paginacao_menu = ""
			paginacao_menu = paginacao_menu&"<table width='123' border='0' cellspacing='0' cellpadding='3'>"
			paginacao_menu = paginacao_menu&"<tr><td width='16'>"
			
			'Verifica se coloca o seta da esquerda
			If int(pagina_atual) > 1 Then
				paginacao_menu = paginacao_menu&"<a href='#' onclick=""paginacaoIrParaPagina('"&query_string&"','"&pagina_atual&"','"&(pagina_atual-1)/1&"','"&qtd_paginas&"')""><img src='images/layout/paginacao_seta_esq.jpg' alt='Ir para p&aacute;gina anterior' width='16' height='16' /></a>"
			
			Else
				paginacao_menu = paginacao_menu&"<img src='images/layout/paginacao_seta_esq_desabilitado.jpg' width='16' height='16' /></a>"
			
			End If
			
			paginacao_menu = paginacao_menu&"</td><td width='17'><div align='left'>"
			
			'Verifica se coloca o seta da direita
			If int(pagina_atual) <> int(qtd_paginas) Then
				paginacao_menu = paginacao_menu&"<a href='#' onclick=""paginacaoIrParaPagina('"&query_string&"','"&pagina_atual&"','"&(pagina_atual+1)/1&"','"&qtd_paginas&"')""><img src='images/layout/paginacao_seta_dir.jpg' alt='Ir para pr&oacute;xima p&aacute;gina' width='16' height='16' /></a>"
			Else
				paginacao_menu = paginacao_menu&"<img src='images/layout/paginacao_seta_dir_desabilitado.jpg' width='16' height='16' /></a>"
			End If
			
			paginacao_menu = paginacao_menu&"</div></td><td width='33'><div align='right'><input onkeypress='mascara(this,soNumeros)' onblur=""paginacaoIrParaPagina('"&query_string&"','"&pagina_atual&"',this.value,'"&qtd_paginas&"')"" style='width:30px; height:20px; padding:0px;' name='paginacao_ir_para_pagina' value='"&pagina_atual&"' /></div></td>"
			paginacao_menu = paginacao_menu&"<td width='4'>/</td>"
			paginacao_menu = paginacao_menu&"<td width='23'><div align='left'>"&qtd_paginas&"</div></td>"
			paginacao_menu = paginacao_menu&"</tr>"
			paginacao_menu = paginacao_menu&"</table>"
			
			Response.Write(paginacao_menu)
		
		End If
	
	End If

End Sub

Function preencheCaracter(valor,caracter,qtd_caracteres)
	
	Dim retorna
	Dim diferenca,i

	retorna = valor

	diferenca = (qtd_caracteres-Len(Cstr(""&valor)))/1
	
	If diferenca > 0 Then
		
		For i=1 to diferenca
			retorna = caracter&retorna
		Next
		
	End If
	
	preencheCaracter = retorna
	
End Function

'Retorna o nome do usu·rio
Function nomeUsuario(cod_usuario,conexao_aberta)

	If not conexao_aberta Then
		AbrirConexao()
	End If

	Dim rs, retorna	
	Set rs=objConexao.Execute("SELECT NOME FROM TB_ADM_USUARIOS WHERE cod_usuario = "&sqlTexto(cod_usuario))
		
		If not rs.Eof Then
			retorna = rs("nome")
		Else
			retorna = ""
		End If
		
	rs.Close
	Set rs=Nothing
	
	If not conexao_aberta Then
		FecharConexao()
	End If
	
	nomeUsuario = retorna
	
End Function

Function padraoTELEFONE(campo)
	Dim tmp
	tmp = ""&trim(campo)
	
	If tmp <> "" Then
	
		If Len(tmp) > 13 Then
		'Limpar
			tmp = Replace(tmp,"-","")
			tmp = Replace(tmp," ","")
			tmp = Replace(tmp,"(","")
			tmp = Replace(tmp,")","")
		Elseif Len(tmp) = 10 Then
		'Colocar mascara
			tmp = "("&Left(tmp,2)&") "&Mid(tmp,3,4)&"-"&Right(tmp,4)
		End If
	
	End If
	
	padraoTELEFONE = tmp
	
End Function

Function estoqueNumeroCaixa(cod_caixa_armazenado,conexao_aberta)

	If not conexao_aberta Then
		AbrirConexao()
	End If


	Dim rs, retorna
	retorna = ""
	
	Set rs=objConexao.Execute("SELECT NUMERO_CAIXA FROM TB_LOCAL_ARMAZENAGEM_SALA_CAIXA WHERE cod_caixa_armazenado = "&sqlTexto(cod_caixa_armazenado))
		
		If not rs.Eof Then
			retorna = rs("NUMERO_CAIXA")
		End if
		
	rs.Close
	Set rs=Nothing

	If not conexao_aberta Then
		FecharConexao()
	End If
	
	estoqueNumeroCaixa = retorna
	
End Function

sub donwloadStream(caminho_completo)
	dim blacklist, aux, vem_da_pasta_dados, whitelist
	whitelist = false
	vem_da_pasta_dados = false

	blacklist = "asp|php|aspx|html|css|js|c|mdb"

	Dim extensao

	'Verificamos se o arquivo est· na blacklist
	aux = split(caminho_completo,".")
	if not instr(1, blacklist, aux(ubound(aux)), vbTextCompare) > 0 then
		whitelist = true
	end if
	
	'validamo se o download vem da pasta dados


	if  whitelist then
		Dim objFSO
		Dim objFile
		Dim objStream
		
		'-- create FSO object to check if file exists and get properties
		Set objFSO = Server.CreateObject("Scripting.FileSystemObject")
		'-- verificamos se o arquivo exite
		If objFSO.FileExists(caminho_completo) Then
			Set objFile = objFSO.GetFile(caminho_completo)
			'-- first clear the response, and then set the appropriate headers
			Response.Clear

			'-- the filename you give it will be the one that is shown
			' to the users by default when they save
			
			Response.AddHeader "Content-Disposition:", "inline; filename=" & objFile.Name
			Response.AddHeader "Content-Length", objFile.Size
			Response.ContentType = "application/octet-stream"
			
			Set objStream = Server.CreateObject("ADODB.Stream")
			objStream.Open
			objStream.Type = 1
			Response.CharSet = "UTF-8"	
			objStream.LoadFromFile(caminho_completo)
			Response.BinaryWrite(objStream.Read)
			objStream.Close
			Set objStream = Nothing
			Set objFile = Nothing
		Else
			Response.Clear
			Response.Write("Arquivo n„o encontrado.")
		End If
		Set objFSO = Nothing
	end if
end sub

sub downloadStreamRenomeia(caminho_completo, nome_arquivo)
	dim blacklist, aux, vem_da_pasta_dados, whitelist
	whitelist = false
	vem_da_pasta_dados = false

	blacklist = "asp|php|aspx|html|css|js|c|mdb"

	'Verificamos se o arquivo est· na blacklist
	aux = split(caminho_completo,".")
	if not instr(1, blacklist, aux(ubound(aux)), vbTextCompare) > 0 then
		whitelist = true
	end if
	
	'validamo se o download vem da pasta dados
	if lcase(left(caminho_completo,len(caminho_dados))) = lcase(caminho_dados)  then
		vem_da_pasta_dados = true
	end if

	if vem_da_pasta_dados and whitelist then
		Dim objFSO
		Dim objFile
		Dim objStream
		
		'-- create FSO object to check if file exists and get properties
		Set objFSO = Server.CreateObject("Scripting.FileSystemObject")
		'-- verificamos se o arquivo exite
		If objFSO.FileExists(caminho_completo) Then
			Set objFile = objFSO.GetFile(caminho_completo)
			'-- first clear the response, and then set the appropriate headers
			Response.Clear

			'-- the filename you give it will be the one that is shown
			' to the users by default when they save
			Response.AddHeader "Content-Disposition", "attachment; filename=" & nome_arquivo
			Response.AddHeader "Content-Length", objFile.Size
			Response.ContentType = "application/octet-stream"
			
			Set objStream = Server.CreateObject("ADODB.Stream")
			objStream.Open
			objStream.Type = 1
			Response.CharSet = "UTF-8"	
			objStream.LoadFromFile(caminho_completo)
			Response.BinaryWrite(objStream.Read)
			objStream.Close
			Set objStream = Nothing
			Set objFile = Nothing
		Else
			Response.Clear
			Response.Write("Arquivo n„o encontrado.")
		End If
		Set objFSO = Nothing
	end if
end sub


sub logEventos(descricao, conexao_aberta)

	if not conexao_aberta then
		abrirConexao()
	end if

	dim aux

	'ADICIONAMOS ALGUMAS TAGS AO LOG
	aux = descricao & "[pagina_execucao:"&Request.ServerVariables("SERVER_NAME")&Request.ServerVariables("URL")&"]"
	aux = aux & "[metodo:"&request.servervariables("REQUEST_METHOD")&"]"
	aux = aux & "[query_string:"&Request.Querystring&"]"
	aux = aux & "[pagina_anterior:"&request.servervariables("http_referer")&"]"
	aux = aux & "[sistema:"&request.servervariables("HTTP_USER_AGENT")&"]"
	aux = aux & "[data_log:"&now()&"]"


	objConexao.Execute("INSERT INTO TB_ADM_LOG_ALTERACOES (COD_USUARIO,DATA_CADASTRADO,DESCRICAO) VALUES ("&session("cod_usuario")&", NOW(), "&sqlTexto(aux)&" )")

	if not conexao_aberta then
		fecharConexao()
	end if

end sub

function getConfiguracoes(conexao_aberta, array_chaves) 

  if not conexao_aberta then
    abrirConexao()
  end if

  dim i : i = 0
  dim count : count = ubound(array_chaves)
  dim chaves : chaves = ""

  while i <= count 
    chaves = chaves & sqlTexto(array_chaves(i)) & ", "
  i = i + 1
  wend

  chaves = left(chaves, len(chaves)-2)

  set retorno = Server.CreateObject("Scripting.Dictionary")
  set rs = objConexao.execute("SELECT chave, valor FROM TB_CONFIGURACOES WHERE chave IN (" & chaves & ")")
    while not rs.Eof 
      call retorno.add(rs("chave").value, rs("valor").value)
    rs.moveNext()
    wend
  rs.close()
  set rs = nothing

  if not conexao_aberta then
    fecharConexao()
  end if 

set getConfiguracoes = retorno
end function


