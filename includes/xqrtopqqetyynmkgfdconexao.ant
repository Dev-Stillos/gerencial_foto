	if rescordSet("cod_pedido") <> "" then
		retorno = "<a target='_blank' href='adm_busca_completa_depto_foto.asp?filtro=1&TIPO_BUSCA=1&BUSCAR_TERMO='"&rescordSet("cod_pedido")&"'&Submit=+'>Pedido: "&rescordSet("cod_pedido")&"</a>"
	elseif rescordSet("cod_pedido_compra") <> "" then
		retorno = "<a target='_blank' href='ppv_compras_pedidos.asp?filtro=1&NUMERO_PEDIDO_COMPRAS="&rescordSet("cod_pedido_compra")&"'>Pedido de Compra: "&rescordSet("cod_pedido_compra")&"</a>"
	elseif rescordSet("cod_vendedor") <> "" then
		retorno = "<a target='_blank' href='dip_controle_producoes.asp'>Vendedor: "&rescordSet("cod_vendedor")&"</a>"
	elseif rescordSet("cod_ordem_servico") <> "" then
		retorno = "<a target='_blank' href='dip_controle_producoes.asp'>Vendedor: "&rescordSet("cod_vendedor")&"</a>"
	else
		retorno = "<a target='_blank' href='est_movimentacao_manual.asp?filtro_cod_movimentacao="&rescordSet("cod_movimentacao")&"'>Entrada manual: "&rescordSet("cod_movimentacao")&"</a>"

	end if
estoqueLink = retorno

end function

sub estoqueMovimentacao(tipo, origem_movimentacao, id, cod_produto, quantidade, descricao, conexao_aberta)
	
	dim rs, retorno, campo_chave, qtd, estoque_saida

	if not conexao_aberta then
		abrirConexao()	
	end if

	'primeiro verificamos qual o tipo de movimentacao
	'E - Entrada
	'S - Saida
	'T - Transferencia -> existe somente na funÁ„o, na base È convertido para uma entrada e uma saida

	if cod_produto = "" or cod_produto = 0 or quantidade = "" or quantidade = 0 then
		response.write "Campos Inv·lidos "
		response.write "<br />cod_produto : "&cod_produto
		response.write "<br />quantidade : "&quantidade
		response.end
	end if
	
	if origem_movimentacao = "pedido" then
		campo_chave = "cod_pedido"

	elseif origem_movimentacao = "pedido_compra" then
		campo_chave = "cod_pedido_compra"

	elseif origem_movimentacao = "vendedor" then
		campo_chave = "cod_vendedor"

	elseif origem_movimentacao = "ordem_servico" then
		campo_chave = "cod_ordem_servico"

	end if	

	if tipo = "S" and quantidade > 0  then
		'Se for saida multiplicamos por -1 para que seja gravado o valor negativo
		qtd = quantidade * (-1)
	else
		qtd = quantidade
	end if

	'VERIFICAMOS SE O O PRODUTO TEM PRODUTOS VINCULADOS SE HOUVER ENTAO BAIXAMOS SOMENTE OS VINCULADOS
	Set rs = objConexao.Execute("SELECT * FROM TB_PRODUTOS_VINCULADOS where cod_produto_pai = "&sqlNumero(cod_produto))
	if not rs.Eof Then

		while not rs.Eof 
			call logEventos("[info:movimentacao no estoque]["&campo_chave&":"&id&"][cod_usuario:"&session("COD_USUARIO")&"][tipo_operacao:"&tipo&"][cod_produto:"&rs("cod_produto_filho")&"][quantidade:"&qtd&"]" , true)

			objConexao.Execute("INSERT INTO TB_ESTOQUE_MOVIMENTACOES ("&campo_chave&", cod_produto, quantidade, descricao, tipo, cod_usuario) VALUES ("&sqlNumero(id)&", "&sqlNumero(rs("cod_produto_filho"))&", "&sqlNumero(qtd)&", "&sqlTexto(descricao)&","&sqlTexto(tipo)&", "&session("cod_usuario")&")")

		rs.MoveNext
		wend

	else
		call logEventos("[info:movimentacao no estoque]["&campo_chave&":"&id&"][cod_usuario:"&session("COD_USUARIO")&"][tipo_operacao:"&tipo&"][cod_produto:"&cod_produto&"][quantidade:"&qtd&"]" , true)

		objConexao.Execute("INSERT INTO TB_ESTOQUE_MOVIMENTACOES ("&campo_chave&", cod_produto, quantidade, descricao, tipo, cod_usuario) VALUES ("&sqlNumero(id)&", "&sqlNumero(cod_produto)&", "&sqlNumero(qtd)&", "&sqlTexto(descricao)&","&sqlTexto(tipo)&", "&session("cod_usuario")&")")

	end if 
	rs.Close
	set rs = nothing

	if not conexao_aberta then
		fecharConexao
	end if

end sub

function estoqueMovimentacaoManual(rescordSet)
	
	dim retorno

	if rescordSet("cod_pedido") <> "" or rescordSet("cod_pedido_compra") <> "" or rescordSet("cod_vendedor") <> "" or rescordSet("cod_ordem_servico") <> "" then
		retorno = false
	else
		retorno = true
	end if
estoqueMovimentacaoManual = retorno

end function

function estoqueVerificaManual(cod_movimentacao, conexao_aberta)

	if not conexao_aberta then
		abrirConexao()
	end if

	dim c : c = ""
	dim cod_vendedor, cod_ordem_servico, cod_pedido, cod_pedido_compra

	set rs = objConexao.Execute("SELECT cod_vendedor, cod_ordem_servico, cod_pedido, cod_pedido_compra FROM TB_ESTOQUE_MOVIMENTACOES WHERE cod_movimentacao = "&sqlNumero(cod_movimentacao))
	if not rs.Eof then

		cod_vendedor = rs("cod_vendedor")&""
		cod_ordem_servico = rs("cod_ordem_servico")&""
		cod_pedido = rs("cod_pedido")&""
		cod_pedido_compra = rs("cod_pedido_compra")&""

	end if
	rs.Close

	if not conexao_aberta then
		fecharConexao()
	end if

estoqueVerificaManual = (cod_vendedor = c) and (cod_ordem_servico = c)  and (cod_pedido_compra = c) and (cod_pedido = c)
end function

