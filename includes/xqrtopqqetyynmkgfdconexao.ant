   Set objConexao=nothing
End Sub



function mackenzieTemporadaAtiva(conexao_aberta)

	Dim retorno, rs

	if not conexao_aberta then
		abrirConexao()
	end if

	Set rs = objConexao.Execute("SELECT cod_mack_temporada FROM TB_MACK_TEMPORADAS WHERE NOW() between inicio AND fim ")
	if not rs.Eof Then
		retorno = rs(0)
	End if
	rs.Close
	Set rs = Nothing

	if not conexao_aberta then
		fecharConexao()
	end if

mackenzieTemporadaAtiva = retorno
end function


