sub estoqueMovimentacaoVendedorRenovacao(cod_movimentacao_vendedor, dias_renovados, conexao_aberta)

	if not conexao_aberta then
		abrirConexao()
	end if

	dim data_devolucao
	data_devolucao = dateadd("d", dias_renovados, now())

	'INSERIMOS NO HISTORICO DE RENOVACOES
	objConexao.execute("INSERT INTO TB_ESTOQUE_MOVIMENTACOES_VENDEDORES_RENOVACOES (cod_movimentacao_vendedor, dias_adicionais,renovado_ate, data_renovacao,cod_usuario) VALUES ("&sqlNumero(cod_movimentacao_vendedor)&", "&sqlNumero(dias_renovados)&", "&sqlData(data_devolucao)&","&sqlNumero(session("cod_usuario"))&")")

	'ALTERAMOS A TABELA DE 
	objConexao.execute("UPDATE TB_ESTOQUE_MOVIMENTACOES_VENDEDORES SET data_devolucao = "&sqlData(data_devolucao)&" where cod_movimentacao_vendedor = "&sqlNumero(cod_movimentacao_vendedor))

	if not conexao_aberta then
		fecharConexao()
	end if

end sub

sub estoqueMovimentacaoVendedor(tipo, cod_vendedor, cod_produto, quantidade, devolver_apos, descricao, conexao_aberta)

	if not conexao_aberta then
		abrirConexao()
	end if

	dim rs, retorno, nome_vendedor, quantidade_saida, possibilidade_saida
	quantidade_saida = quantidade

	dim data_movimentacao, data_devolucao, cod_usuario

	data_movimentacao = now()
	data_devolucao = dateadd("d",devolver_apos, data_movimentacao )
	cod_usuario = session("cod_usuario")


	if tipo = "S" and quantidade > 0  then
		'Se for saida multiplicamos por -1 para que seja gravado o valor negativo
		qtd = quantidade * (-1)
	else
		qtd = quantidade
	end if

	'VERIFICAMOS SE O O PRODUTO TEM PRODUTOS VINCULADOS SE HOUVER ENTAO BAIXAMOS SOMENTE OS VINCULADOS
	Set rs1 = objConexao.Execute("SELECT * FROM TB_PRODUTOS_VINCULADOS where cod_produto_pai = "&sqlNumero(cod_produto))
	if not rs1.Eof Then

		while not rs1.Eof 
		
			if tipo = "S" then

				'Se for do tipo saida ent„o atualizamos
				Set rs = objConexao.execute("Select * from TB_ESTOQUE_MOVIMENTACOES_VENDEDORES WHERE tipo = 'E' AND quantidade > quantidade_saida and  cod_produto = "&sqlNumero(rs1("cod_produto_filho"))&" order by data_movimentacao")
				if not rs.eof then

					while quantidade > 0 and not rs.eof
						'verificamos quantos podemos dar saida
				
						possibilidade_saida = rs("quantidade") - rs("quantidade_saida")

						if (possibilidade_saida - quantidade) >= 0 then

							objConexao.execute("UPDATE TB_ESTOQUE_MOVIMENTACOES_VENDEDORES SET quantidade_saida = "&sqlNumero(rs("quantidade_saida")+quantidade)&" WHERE cod_movimentacao_vendedor = "&sqlNumero(rs("cod_movimentacao_vendedor")))

						else 'n„o foi possÌvel deduzir tudo de uma ˙nica
							'deduzimos somente o possÌvel
							objConexao.execute("UPDATE TB_ESTOQUE_MOVIMENTACOES_VENDEDORES SET quantidade_saida = "&sqlNumero(((quantidade - possibilidade_saida) - quantidade) + rs("quantidade_saida") )&" WHERE cod_movimentacao_vendedor = "&sqlNumero(rs("cod_movimentacao_vendedor")))
						end if
						
					rs.MoveNext
					Wend
				else
					'enviar email'
					'de aviso pois o vendedor n„o tem estoque para dar saida
				end if
				rs.Close
				set rs = nothing

				if quantidade_saida > 0 then 
					'enviar email'
					'de aviso pois o vendedor n„o tem estoque para dar saida
				end If

			end if
			
			objConexao.execute("INSERT INTO TB_ESTOQUE_MOVIMENTACOES_VENDEDORES (tipo, cod_vendedor, cod_produto, quantidade, data_movimentacao, data_devolucao, cod_usuario, descricao) VALUES ("&sqlTexto(tipo)&", "&sqlNumero(cod_vendedor)&", "&sqlNumero(rs1("cod_produto_filho"))&", "&sqlNumero(quantidade)&", "&sqlData(data_movimentacao)&", "&sqlData(data_devolucao)&", "&sqlNumero(cod_usuario)&","&sqlTexto(descricao)&")")

		rs1.MoveNext
		wend
		rs1.Close
		set rs = nothing
	else

		if tipo = "S" then

			'Se for do tipo saida ent„o atualizamos
			Set rs = objConexao.execute("Select * from TB_ESTOQUE_MOVIMENTACOES_VENDEDORES WHERE tipo = 'E' AND quantidade > quantidade_saida and  cod_produto = "&sqlNumero(cod_produto)&" order by data_movimentacao")
			if not rs.eof then

				while quantidade > 0 and not rs.eof
					'verificamos quantos podemos dar saida
			
					possibilidade_saida = rs("quantidade") - rs("quantidade_saida")

					if (possibilidade_saida - quantidade) >= 0 then

						objConexao.execute("UPDATE TB_ESTOQUE_MOVIMENTACOES_VENDEDORES SET quantidade_saida = "&sqlNumero(rs("quantidade_saida")+quantidade)&" WHERE cod_movimentacao_vendedor = "&sqlNumero(rs("cod_movimentacao_vendedor")))

					else 'n„o foi possÌvel deduzir tudo de uma ˙nica
						'deduzimos somente o possÌvel
						objConexao.execute("UPDATE TB_ESTOQUE_MOVIMENTACOES_VENDEDORES SET quantidade_saida = "&sqlNumero(((quantidade - possibilidade_saida) - quantidade) + rs("quantidade_saida") )&" WHERE cod_movimentacao_vendedor = "&sqlNumero(rs("cod_movimentacao_vendedor")))
					end if
					
				rs.MoveNext
				Wend
			else
				'enviar email'
				'de aviso pois o vendedor n„o tem estoque para dar saida
			end if
			rs.Close
			set rs = nothing

			if quantidade_saida > 0 then 
				'enviar email'
				'de aviso pois o vendedor n„o tem estoque para dar saida
			end If
		end if
		
		objConexao.execute("INSERT INTO TB_ESTOQUE_MOVIMENTACOES_VENDEDORES (tipo, cod_vendedor, cod_produto, quantidade, data_movimentacao, data_devolucao, cod_usuario, descricao) VALUES ("&sqlTexto(tipo)&", "&sqlNumero(cod_vendedor)&", "&sqlNumero(cod_produto)&", "&sqlNumero(quantidade)&", "&sqlData(data_movimentacao)&", "&sqlData(data_devolucao)&", "&sqlNumero(cod_usuario)&","&sqlTexto(descricao)&")")

	end if

	if not conexao_aberta then
		fecharConexao()
	end if

end sub


function estoqueMomentoBaixa(cod_produto, conexao_aberta)

	dim retorno, rs, aux
	aux = ""
	
	if not conexao_aberta then
		abrirConexao()
	end if 

	Set rs = objConexao.execute("SELECT saida_automatica FROM  TB_PRODUTOS WHERE COD_PRODUTO = "&sqlNumero(cod_produto))
	if not rs.Eof then
		aux = rs(0)
	end if
	rs.Close
	set rs = nothing

	if aux = "1" then
		retorno  = "venda"

	elseif aux = "2" then
		retorno  = "producao"

	else
		retorno  = ""

	end if



	if not conexao_aberta then
		fecharConexao()
	end if 

	estoqueMomentoBaixa = retorno
end function

