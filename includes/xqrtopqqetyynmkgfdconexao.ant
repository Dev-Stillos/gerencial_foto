'FunÁ„o que Prepara um Numero para ser executado no banco
'dentro de uma express„o sql
'Por exemplo: R$ 1.000,23  --> 1000.23
Function sqlNumero(numero)
   Dim temp, ultimos_3_carac, qtdUlTimosCaras
	 temp=Replace(numero,"R$", "")  'retira o R$, se houver
	 temp=Replace(temp, " ", "") 'retira os espaÁos, se houver
	 ultimos_3_carac = Right(temp,3)
	 qtdUlTimosCaras = Len(ultimos_3_carac)
	 temp=Mid(temp,1,len(temp)-qtdUlTimosCaras)&Replace(ultimos_3_carac,".",",")
	 temp=Replace(temp, ".", "") 'retira os pontos, se houver
	 temp=Replace(temp, "," , ".") 'Substitui a virgula por ponto
	 
	 sqlNumero = temp
End Function

'Ex.: 11/06/2008 ==> '2008-6-11'
Function sqlData(DATA)
   Dim temp, DIA, MES, ANO, HORA, MINUTOS, SEGUNDOS
   temp = DATA

   If Len(DATA) > 2 Then
	   	temp = formatDateTime(DATA)
	  	DIA = Day(temp)
	   	MES = Month(temp)
	   	ANO = Year(temp)

	 	HORA		= Cstr(""&Hour(temp))
		MINUTOS		= Cstr(""&Minute(temp))
		SEGUNDOS	= Cstr(""&Second(temp))
		
		'Response.Write(HORA&":"&MINUTOS&":"&SEGUNDOS)
		If HORA <> "" and MINUTOS <> "" and SEGUNDOS <> "" Then
		   	temp = "'"&ANO&"-"&MES&"-"&DIA&" "&HORA&":"&MINUTOS&":"&SEGUNDOS&"'"
		Else
	   	   	temp = "'"&ANO&"-"&MES&"-"&DIA&"'"
		End If
		
		sqlData = temp

   Else
   		sqlData ="NULL" 
   End If
   
End Function

'Ex.: Campo fornece 0 a sub retira e deixa branco
Function retiraZero(CAMPO)
	Dim temp
	
	temp = formatNumber(CAMPO)
	If temp = 0 then
		temp = ""		
	End if
	
	retiraZero = temp
	
End function

'FuncÁ„o que prepara um texto para ser executado no banco
'dentro de uma express„o sql
'e coloca os apÛstrofos
'por exemplo: Joana D'ark ---> 'Joana D''ark'
'             Maria       ---> 'Maria'              
Function sqlTexto(texto)
  Dim temp
    temp=texto
  	temp= temp&""
	temp=Replace(temp,"'", "''")
	temp= "'"  & temp  & "'"
	sqlTexto=temp
End Function


Function TrocarAcento(Palavra) 
CAcento = "‡·‚„‰ËÈÍÎÏÌÓÔÚÛÙıˆ˘˙˚¸¿¡¬√ƒ»… ÀÃÕŒ“”‘’÷Ÿ⁄€‹Á«Ò—" 
SAcento = "aaaaaeeeeiiiiooooouuuuAAAAAEEEEIIIOOOOOUUUUcCnN" 
Texto = "" 
If Palavra <> "" then 
        For X = 1 To Len(Palavra) 
               Letra = Mid(Palavra,X,1) 
               Pos_Acento = InStr(CAcento,Letra) 
               If Pos_Acento > 0 Then Letra = Mid(SAcento,Pos_Acento,1) 
               Texto = Texto & Letra
        Next 
        TrocarAcento = Texto 
End If 
End Function
 
Function RemoverAcento(Palavra) 
CAcento = "‡·‚„‰ËÈÍÎÏÌÓÔÚÛÙıˆ˘˙˚¸¿¡¬√ƒ»… ÀÃÕŒ“”‘’÷Ÿ⁄€‹Á«Ò—" 
Texto = "" 
If Palavra <> "" Then 
        For X = 1 to Len(Palavra) 
               Letra = Mid(Palavra,X,1) 
               Pos_Acento = InStr(CAcento,Letra) 
              If Pos_Acento > 0 Then Letra = "" 
             Texto = Texto & Letra 
        Next 
      RemoverAcento = Texto 
End If 
End Function  

'QuantidadeDiasMes("2008-2-25")
'=28
Function QuantidadeDiasMes(DATA)
Dim AnoBi, qtdDiasMesArray(15)

AnoBi = Year(DATA) Mod 4
		IF AnoBi = 0 then
				AnoBi = 29		
		else
				AnoBi = 28
		End If
						
		qtdDiasMesArray(1) = 31'Jan
		qtdDiasMesArray(2) = AnoBi
		qtdDiasMesArray(3) = 31'Mar
		qtdDiasMesArray(4) = 30'Abr
		qtdDiasMesArray(5) = 31'Mai
		qtdDiasMesArray(6) = 30'Jun
		qtdDiasMesArray(7) = 31'Jul
		qtdDiasMesArray(8) = 31'Ago
		qtdDiasMesArray(9) = 30'Set
		qtdDiasMesArray(10) = 31'Out
		qtdDiasMesArray(11) = 30'Nov
		qtdDiasMesArray(12) = 31'Dez
		
		QuantidadeDiasMes = qtdDiasMesArray(Month(DATA))

End Function  

'Ex.: 1 = Sim e 2 = N„o o contr·rio È valido
Function booleano (VALOR)

	Dim temp
	temp = VALOR
	
	If isNumeric(temp) Then 
			If temp = 1 Then
				temp = "Sim"
			Elseif temp = 2 Then
				temp = "N„o"
			End If
	Else
		
		If temp = "Sim" Then
			temp = 1
		Elseif temp = "N„o" Then
			temp = 2
		End If
		'--------------------------------------------
		If temp = "S" Then
			temp = "Sim"
		Elseif temp = "N" Then
			temp = "N„o"
		End If
		
	End If
	
	booleano = temp
	
End Function

'Colocar 0 antes do dia e mÍs
' Ex.: 1/1/2008 ou 1/1/08 
' = 01/01/2008 
Function ArrumaData(DATA)
	dim temp
	temp = DATA
	temp = ""&temp
 If temp <> Empty Then
	
	Dim DIA, MES, ANO, HORA, MINUTOS, SEGUNDOS

	If IsDate(DATA) Then
		DIA 		= Day(DATA)
		MES 		= Month(DATA)
		ANO 		= Year(DATA)
		HORA		= Hour(DATA)
		MINUTOS		= Minute(DATA)
		SEGUNDOS	= Second(DATA)
	End If

If Len(DIA) = 1 then

	DIA = "0"&DIA

End If

If Len(MES) = 1 then

	MES = "0"&MES

End If

If Len(ANO) = 2 then

	ANO = "20"&ANO

End If
	
	If HORA <> Empty Then
		
			If Len(HORA) = 1 then
				HORA = "0"&HORA
			End If
			
			If Len(MINUTOS) = 1 then
				MINUTOS = "0"&MINUTOS
			End If

			If Len(SEGUNDOS) = 1 then
				SEGUNDOS = "0"&SEGUNDOS
			End If
	
	
		ArrumaData = DIA&"/"&MES&"/"&ANO&" "&HORA&":"&MINUTOS&":"&SEGUNDOS
	Else
		ArrumaData = DIA&"/"&MES&"/"&ANO
	End If
Else
 	ArrumaData = ""
End If

End Function

'Formatar n˙mero Ex.: 150.87 = 150,87 ou 180 È = 180
Function ArrumaNumero(CAMPO,RETORNASEZERO,CASASDECIMAIS)

	Dim temp
	temp = CAMPO

	If isNull(temp) or temp = "" Then
		temp = 0
	End If

	temp = formatNumber(temp,CASASDECIMAIS)

	If temp <> 0 then
		ArrumaNumero = temp
	Else
		ArrumaNumero = RETORNASEZERO
	End If

End Function


'Ex.: 15151510 = 151515-0 a recÌproca È verdadeira
Function digito(CAMPO)
	Dim temp,qtdCarac,valorDigito, a
	
	temp = CAMPO
	
	If isNumeric(CAMPO) then
	'Sem digito dever· colocar

		qtdCarac = Len(temp)
		valorDigito = Right(temp,1)
		
		a = Left(temp,Len(temp)-1)
		
		digito = a&"-"&valorDigito
	else
	'Com digito dever· tirar
	
		temp = Replace(temp,"-","")
		temp = Replace(temp," ","")
		digito = temp
	
	End If

End Function

Function criptografar(CAMPO)
	Dim temp
	temp = CAMPO
	
	
	If isNumeric(CAMPO) Then
	'Criptografar
		temp = Replace(temp,".","")
		temp = Replace(temp,",","")
		temp = Replace(temp,"0","PyQds")
		temp = Replace(temp,"1","qfcpG")
		temp = Replace(temp,"2","qazpe")
		temp = Replace(temp,"3","puyfj")
		temp = Replace(temp,"4","mpoaq")
		temp = Replace(temp,"5","pousW")
		temp = Replace(temp,"6","WEOyc")
		temp = Replace(temp,"7","qKjwe")	
		temp = Replace(temp,"8","oirqi")
		temp = Replace(temp,"9","IjgPb")
		
		criptografar = temp
		
	Else
	'Descriptografar
		temp = Replace(temp,".","")
		temp = Replace(temp,",","")
		temp = Replace(temp,"PyQds","0")
		temp = Replace(temp,"qfcpG","1")
		temp = Replace(temp,"qazpe","2")
		temp = Replace(temp,"puyfj","3")
		temp = Replace(temp,"mpoaq","4")
		temp = Replace(temp,"pousW","5")
		temp = Replace(temp,"WEOyc","6")
		temp = Replace(temp,"qKjwe","7")	
		temp = Replace(temp,"oirqi","8")
		temp = Replace(temp,"IjgPb","9")
		
		criptografar = temp
			
	End If

End Function
'De 999.999.999-82 = 99999999982 o contr·rio È valido tambÈm
Function mascaraCPF (CAMPO)
Dim temp
temp = CAMPO
	If Len(temp) = 11 Then
	'Coloca m·scara
	
		Dim parte1, parte2, parte3, parte4
		
		parte1 = Mid(CAMPO,1,3)
		parte2 = Mid(CAMPO,4,3)
		parte3 = Mid(CAMPO,7,3)
		parte4 = Mid(CAMPO,10,2)
		
		temp = parte1&"."&parte2&"."&parte3&"-"&parte4
	Else
	'Retira m·scara
	
		temp = Replace(temp,".","")
		temp = Replace(temp,"-","")
		temp = Replace(temp," ","")

	End If
	
	mascaraCPF = temp
	
End function

Function formataData(CAMPO)
Dim temp
Dim dia, mes, ano

temp = ""&CAMPO

	If temp <> "" and isDate(temp) Then
		dia = Day(temp)
		mes = Month(temp)
		ano = Year(temp)
		
		If Len(dia) = 1 Then
			dia = "0"&dia
		End if
		
		If Len(mes) = 1 Then
			mes = "0"&mes
		End if
		
		temp = dia&"/"&mes&"/"&ano
	Else
		temp = " - "
	End If

	formataData = temp
	
End Function

'Formatar n˙mero Ex.: 150.87 = 150,87 ou 180 È = 180
Function formatarNumero(CAMPO)

Dim temp
temp = CAMPO
temp = formatNumber(temp)
	
	If temp > 0 then
		formatarNumero = temp
	Else		
		formatarNumero = ""
	End If	
	
End Function

Function retiraLetras(CAMPO)
Dim temp
	
End Function


'"TABELA","COLUNA","CONTE⁄DO_NOVO","redirecionar para","nome da coluna da tabela chave","valor da chave"
Sub chaveUnica(tabela,campoUnico,conteudoNovo,redirecionar,comando,campoChave,valorCampoChave)

Dim duplicidadeCampo, rs, sql, validacao_label, tipoBase, campoVery, vlCampoChave, ctNovo

duplicidadeCampo = ""
vlCampoChave = valorCampoChave
ctNovo = conteudoNovo

'Corrige os campos para verificaÁ„o melhor
vlCampoChave = Trim(Replace(vlCampoChave,Chr(9),""))
vlCampoChave = Trim(Replace(vlCampoChave,Chr(13),""))
ctNovo = Trim(Replace(ctNovo,Chr(9),""))
ctNovo = Trim(Replace(ctNovo,Chr(13),""))

	AbrirConexao
		
		If comando = "incluir" Then
			sql = "SELECT "&campoUnico&" FROM "&tabela&" WHERE "&campoUnico&" ="&sqlTexto(ctNovo)	
		Elseif comando = "alterar" Then
			sql = "SELECT "&campoUnico&" FROM "&tabela&" WHERE ("&campoChave&" <> "&sqlTexto(vlCampoChave)&")  AND  "&campoUnico&" ="&sqlTexto(ctNovo)
		End If
		
				
		Set rs = objConexao.Execute(sql)
			If not rs.Eof Then
			'Encontrou 1 registro pelo menos
				duplicidadeCampo = campoUnico 
			
			End If
					
		rs.Close
		Set rs = Nothing
	
	FecharConexao
	
	If duplicidadeCampo <> "" Then
		Response.Redirect(redirecionar&campoUnico)
	End If
	
End Sub


'campo_chave_original,tabelas_verifica,nome_que_o_campo_aparece_nas_tabelas,paginaretornar
'Exemplo call verificaAntesExcluir(1,"tabela1;tabela2","cod_usuario_id",redirecionar_excluir)
'NUNCA PODER¡ J¡ VIR COM A CONEX√O ABERTA!!!
Sub verificaAntesExcluir(valorCampoChave,tabelasRelacionadas,nomeCampoNasTabelas,redirecionar)
	
Tabelas = Split(tabelasRelacionadas,";")
PodeExcluir = true
		
		AbrirConexao()
			
			For i = 0 to Ubound(Tabelas)
					Set rs = objConexao.Execute("SELECT * FROM "&Tabelas(i)&" where "&nomeCampoNasTabelas&" = "&sqlTexto(valorCampoChave))
							
						If not rs.Eof Then
						'Encontrou registros, n„o È possÌvel excluir
							PodeExcluir = False
						End If	
					
					rs.Close
					Set rs = Nothing
			Next
		
		FecharConexao()

		If PodeExcluir = false Then
			Response.Redirect(redirecionar)
		End If
		
End Sub

'Deleta um arquivo.
Sub deletarArquivo(arquivo_completo)

	Dim FSO2
	Set FSO2 = Server.CreateObject("Scripting.FileSystemObject")
	If FSO2.FileExists(arquivo_completo) Then
		FSO2.DeleteFile arquivo_completo
	End If
	
	Set FSO2 = Nothing
	
End Sub


sub eviarEmailAutenticado(para,copia,copiaOculta,assunto,mensagem)
	


	sRemetente = "webmaster@stillos.com.br"
		sResponder = "webmaster@stillos.com.br"
		sAssunto = assunto
		
		Set objCDOSYSMail = Server.CreateObject("CDO.Message") 
		Set objCDOSYSCon = Server.CreateObject ("CDO.Configuration") 
		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/smtpserver") = "smtp.stillos.com.br" 
		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/smtpserverport")= 587
		
		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/sendusing") = 2
		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout") = 30


		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/smtpauthenticate") = 1
		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/sendusername") = "reports@stillos.com.br"
		objCDOSYSCon.Fields("http://schemas.microsoft.com/cdo/configuration/sendpassword") = "re13962@87fes"


		objCDOSYSCon.Fields.update 
		Set objCDOSYSMail.Configuration = objCDOSYSCon 			
	
		'"email1@com; email2@com" 
		objCDOSYSMail.From = sRemetente
		objCDOSYSMail.To   = para	

		If Len(copia) > 3  Then
				objCDOSYSMail.CC = copia
		End If
		
		If Len(copiaOculta) > 3 Then
			objCDOSYSMail.BCC  = copiaOculta
		End If
				
		objCDOSYSMail.ReplyTo = sResponder 
		objCDOSYSMail.Subject = sAssunto 
		objCDOSYSMail.HtmlBody = mensagem
		
		
		If Len(para) > 3 or Len(copia) > 3 or Len(copiaOculta) Then
		'Pelo menos 1 destes deve estar preenchido para enviar o e-mail
			objCDOSYSMail.Send 
		End If
		
		Set objCDOSYSMail = Nothing 
		Set objCDOSYSCon = Nothing

end sub


